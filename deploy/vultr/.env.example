# Copy to deploy/vultr/.env on the server (never commit .env). Same values as on Render today.
ACME_EMAIL=you@example.com

# API (secrets)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
FIREBASE_PROJECT_ID=buildx-15494
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@buildx-15494.iam.gserviceaccount.com
# Keep the \n escapes, on one line, in double quotes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ANTHROPIC_API_KEY=
GOOGLE_MAPS_API_KEY=
ORDERS_REQUIRE_DELIVERY_PINCODE=false

# Websites (public values, they ship to every browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=buildx-15494.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=buildx-15494
NEXT_PUBLIC_PHONE_SIGNIN=false
NEXT_PUBLIC_ALLOW_INDEXING=true
NEXT_PUBLIC_SUPPORT_EMAIL=support@sthiva.com
