# Copy to apps/api/.env and fill in. Never commit the real .env.
NODE_ENV=development
API_PORT=4000
# Comma-separated website origins allowed to call the API (CORS)
FRONTEND_URL=http://localhost:3000,http://localhost:3001,http://localhost:3002

MONGODB_URI=mongodb://127.0.0.1:27017/sthiva

# Firebase Admin (service account). Optional locally with gcloud application-default login; required in production.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudinary (product photos, private supplier documents)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional
REDIS_URL=redis://localhost:6379
GOOGLE_MAPS_API_KEY=
ANTHROPIC_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
