# Copy to .env.local for local development.

# Base URL of the API — no /api/v1 suffix, the app adds that itself.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Firebase Web App config (Project settings → General → Your apps → Web app, in the Firebase
# console). These are public client identifiers, not secrets — safe to commit to a real .env
# file is still avoided here only by convention, matching the rest of this repo.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
